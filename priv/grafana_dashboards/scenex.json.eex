      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "<%= @datasource_id %>"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(scenex_prom_ex_phoenix_http_request_duration_milliseconds_bucket{job=\"$job\", instance=\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "<%= @datasource_id %>"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(scenex_prom_ex_phoenix_live_view_mount_duration_milliseconds_bucket{job=\"$job\", instance=\"$instance\"}[$__rate_interval])))",
          "legendFormat": "LiveView mount p95",
          "refId": "B",
          "range": true
        }
      ],
      "options": {
        "legend": {
