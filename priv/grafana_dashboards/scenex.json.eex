    {
      "id": 24,
      "type": "timeseries",
      "title": "HTTP requests per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "<%= @datasource_id %>"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "<%= @datasource_id %>"
          },
          "expr": "sum by (status) (rate(scenex_prom_ex_phoenix_http_requests_total{job=\"$job\", instance=\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "range": true
