  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "Scenex",
    "<%= @otp_app %>"
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "<%= @datasource_id %>"
        },
        "query": "label_values(<%= @prom_ex_metric_prefix %>_status_info, job)",
        "definition": "label_values(<%= @prom_ex_metric_prefix %>_status_info, job)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "sort": 1,
        "options": [],
        "regex": ""
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "<%= @datasource_id %>"
        },
        "query": "label_values(<%= @prom_ex_metric_prefix %>_status_info{job=\"$job\"}, instance)",
        "definition": "label_values(<%= @prom_ex_metric_prefix %>_status_info{job=\"$job\"}, instance)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "hide": 0,
