    {
      "id": 19,
      "type": "stat",
      "title": "Pending invitations",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "<%= @datasource_id %>"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "<%= @datasource_id %>"
          },
          "expr": "scenex_platform_invitations_pending{job=\"$job\", instance=\"$instance\"}",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
