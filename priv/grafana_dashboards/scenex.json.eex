        "type": "prometheus",
        "uid": "<%= @datasource_id %>"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "<%= @datasource_id %>"
          },
          "expr": "scenex_play_connected_clients{job=\"$job\", instance=\"$instance\", role=\"gm\"}",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
