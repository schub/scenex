      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Connected clients",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "<%= @datasource_id %>"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "<%= @datasource_id %>"
          },
          "expr": "scenex_play_connected_clients{job=\"$job\", instance=\"$instance\"}",
          "legendFormat": "{{role}}",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Session events per minute",
      "description": "Beats triggered, decisions, deadlines, sessions started/ended.",
      "datasource": {
        "type": "prometheus",
        "uid": "<%= @datasource_id %>"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "<%= @datasource_id %>"
          },
          "expr": "sum by (type) (rate(scenex_play_events_total{job=\"$job\", instance=\"$instance\"}[$__rate_interval])) * 60",
          "legendFormat": "{{type}}",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Commands",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Command latency",
      "description": "GM and player commands, end to end including the database write.",
      "datasource": {
        "type": "prometheus",
        "uid": "<%= @datasource_id %>"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "<%= @datasource_id %>"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(scenex_play_command_duration_milliseconds_bucket{job=\"$job\", instance=\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "<%= @datasource_id %>"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(scenex_play_command_duration_milliseconds_bucket{job=\"$job\", instance=\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "<%= @datasource_id %>"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(scenex_play_command_duration_milliseconds_bucket{job=\"$job\", instance=\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Rejected commands",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "<%= @datasource_id %>"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "<%= @datasource_id %>"
          },
          "expr": "sum by (command, reason) (increase(scenex_play_commands_rejected_total{job=\"$job\", instance=\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{command}}: {{reason}}",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "GM corrections",
      "description": "Decisions overwritten after they were already set.",
      "datasource": {
        "type": "prometheus",
        "uid": "<%= @datasource_id %>"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "<%= @datasource_id %>"
          },
          "expr": "sum(increase(scenex_play_events_total{job=\"$job\", instance=\"$instance\", correction=\"true\"}[$__rate_interval]))",
          "legendFormat": "corrections",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
